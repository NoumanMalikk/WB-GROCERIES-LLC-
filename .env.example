# Site
NEXT_PUBLIC_SITE_URL=https://wb-groceries-llc.vercel.app
NEXT_PUBLIC_STORE_NAME=WB Groceries
NEXT_PUBLIC_BRAND_DESCRIPTOR=Groceries & Everyday Essentials
# Keep "demo" until Square keys are added and sandbox payments are tested.
# Switch to "live" only when ready to accept real payments.
NEXT_PUBLIC_STORE_MODE=demo
NEXT_PUBLIC_SHOW_FULL_ADDRESS=false

# ---------------------------------------------------------------------------
# Square payments (PRIMARY)
# Paste values from https://developer.squareup.com/apps
# NEVER commit real secrets. Put them in Vercel Environment Variables or local .env.local only.
# ---------------------------------------------------------------------------
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Optional legacy Stripe fallback (not required when Square is used)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional services
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

RESEND_API_KEY=
ORDER_EMAIL_FROM=
SUPPORT_EMAIL=
CONTACT_FORM_RECIPIENT=

NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

CRON_SECRET=
